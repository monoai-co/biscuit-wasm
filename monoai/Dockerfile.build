# Reproducible build of module/. One pinned image and platform, so the host never
# changes Cargo's metadata hashes or the resulting bytes.
#   docker buildx build --platform linux/amd64 -f monoai/Dockerfile.build --output module .
FROM rust:1.99.1-slim-bookworm@sha256:16113eb5d5c1e25d9359f40115225ce8719997fb0d9a3dab83e921da0308992f AS build

ADD --checksum=sha256:82d12bb940e2d4e72e0d5605387fc1b8ca179044e012b620f0ce4e7440e8320e \
  https://github.com/wasm-bindgen/wasm-bindgen/releases/download/0.2.129/wasm-bindgen-0.2.129-x86_64-unknown-linux-musl.tar.gz \
  /tmp/wasm-bindgen.tar.gz
RUN tar -xzf /tmp/wasm-bindgen.tar.gz -C /usr/local/bin --strip-components=1 \
  && rustup target add wasm32-unknown-unknown

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src src
COPY snippets snippets
COPY monoai/build.sh monoai/build.sh
RUN bash monoai/build.sh

FROM scratch
COPY --from=build /src/module/ /
